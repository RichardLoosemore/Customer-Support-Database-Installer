			  <TablixCell><CellContents><Textbox Name="DDate"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=IIf(IsNothing(Fields!DateText.Value), "", Fields!DateText.Value)</Value><Style /></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><Style><BottomBorder><Color>Silver</Color><Style>Solid</Style></BottomBorder><FontFamily>Segoe UI</FontFamily><FontSize>7pt</FontSize></Style></Textbox></CellContents></TablixCell>
			  <TablixCell><CellContents><Textbox Name="DUser"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=IIf(IsNothing(Fields!UserName.Value), "", Fields!UserName.Value)</Value><Style /></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><Style><BottomBorder><Color>Silver</Color><Style>Solid</Style></BottomBorder><FontFamily>Segoe UI</FontFamily><FontSize>7pt</FontSize></Style></Textbox></CellContents></TablixCell>
			  <TablixCell><CellContents><Textbox Name="DComment"><CanGrow>true</CanGrow><Paragraphs><Paragraph><TextRuns><TextRun><Value>=IIf(IsNothing(Fields!Comment.Value), "", Fields!Comment.Value)</Value><Style /></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style><BottomBorder><Color>Silver</Color><Style>Solid</Style></BottomBorder><FontFamily>Segoe UI</FontFamily><FontSize>7pt</FontSize></Style></Textbox></CellContents></TablixCell>

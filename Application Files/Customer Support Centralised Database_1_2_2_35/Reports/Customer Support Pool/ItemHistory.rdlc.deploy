  <Body>
	<ReportItems>
	  <Textbox Name="TitleTextbox"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Item History</Value><Style><FontSize>12pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Top>0.15in</Top><Left>0.25in</Left><Height>0.3in</Height><Width>6.9in</Width><Style><FontFamily>Segoe UI</FontFamily></Style></Textbox>
	  <Textbox Name="RangeText"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=IIf(IsNothing(First(Fields!DateRangeText.Value, "CompanyHeader")), "", First(Fields!DateRangeText.Value, "CompanyHeader"))</Value><Style><FontSize>8.5pt</FontSize></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Top>0.48in</Top><Left>0.25in</Left><Height>0.2in</Height><Width>6.9in</Width><Style><FontFamily>Segoe UI</FontFamily></Style></Textbox>

          <Source>Database</Source>
          <Value>=First(Fields!LogoBytes.Value, "CompanyHeader")</Value>
          <MIMEType>image/png</MIMEType>
          <Sizing>FitProportional</Sizing>
          <Top>0.05in</Top>
          <Left>0.25in</Left>
          <Height>0.8in</Height>
          <Width>2in</Width>

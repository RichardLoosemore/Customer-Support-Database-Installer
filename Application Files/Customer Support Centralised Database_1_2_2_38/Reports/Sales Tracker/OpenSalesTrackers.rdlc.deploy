                            <TextRun>
                              <Value>=Fields!Status.Value</Value>
                              <Style>
                                <FontWeight>Bold</FontWeight>
                                <Color>=Switch(
                                  Fields!Status.Value = "Open", "#C00000",
                                  Fields!Status.Value = "Quote", "#ED7D31",
                                  Fields!Status.Value = "Order", "#548235",
                                  Fields!Status.Value = "Lost", "#7F7F7F",
                                  True, "Black"
                                )</Color>
                              </Style>
                            </TextRun>
                          </TextRuns>
                          <Style>
                            <TextAlign>Center</TextAlign>
                          </Style>

  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="MainDataSource">
      <ConnectionProperties>
        <DataProvider>System.Data.DataSet</DataProvider>
        <ConnectString />
      </ConnectionProperties>
      <rd:DataSourceID>a1b2c3d4-e5f6-7890-abcd-ef1234567890</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="CompanyHeader">
      <Query>
        <DataSourceName>MainDataSource</DataSourceName>
        <CommandText>/* Local object data */</CommandText>
      </Query>
      <Fields>
        <Field Name="CompanyName">
          <DataField>CompanyName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="PrimaryColour">
          <DataField>PrimaryColour</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="LogoBytes">
          <DataField>LogoBytes</DataField>
          <rd:TypeName>System.Byte[]</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="OpenSalesTrackerItems">
      <Query>
        <DataSourceName>MainDataSource</DataSourceName>
        <CommandText>/* Local object data */</CommandText>
      </Query>
      <Fields>
        <Field Name="TrackerID">
          <DataField>TrackerID</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Engineer">
          <DataField>Engineer</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DatePosted">

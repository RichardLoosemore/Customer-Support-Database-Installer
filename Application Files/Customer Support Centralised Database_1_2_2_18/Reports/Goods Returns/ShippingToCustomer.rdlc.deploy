        </Style>
      </Textbox>
      <Textbox Name="ReferenceBlock">
        <CanGrow>true</CanGrow>
        <KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>="Sheppee Ref number: " &amp; First(Fields!SheppeeRefNumber.Value, "ShippingToCustomerHeader") &amp; vbCrLf &amp; "Sheppee Quote / Order number: " &amp; First(Fields!SheppeeQuoteOrderNumber.Value, "ShippingToCustomerHeader") &amp; vbCrLf &amp; "Required on site: " &amp; First(Fields!RequiredOnSite.Value, "ShippingToCustomerHeader")</Value>
                <Style>
                  <FontSize>8pt</FontSize>
                </Style>
              </TextRun>
            </TextRuns>
            <Style />

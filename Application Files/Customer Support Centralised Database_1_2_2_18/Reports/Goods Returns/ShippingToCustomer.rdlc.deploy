<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2008/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <Body>
    <ReportItems>
      <Textbox Name="AttentionHeading">
        <CanGrow>true</CanGrow>
        <KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>For the Attention Of:</Value>
                <Style>
                  <FontSize>9pt</FontSize>
                  <FontWeight>Bold</FontWeight>
                </Style>
              </TextRun>
            </TextRuns>
            <Style />
          </Paragraph>
        </Paragraphs>
        <Top>0.075in</Top>
        <Left>0.55in</Left>
        <Height>0.2in</Height>
        <Width>2.4in</Width>
        <Style>
          <FontFamily>Segoe UI</FontFamily>
        </Style>
      </Textbox>
      <Textbox Name="AttentionBlock">
        <CanGrow>true</CanGrow>
        <KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>=Trim(First(Fields!AttentionTitle.Value, "ShippingToCustomerHeader") &amp; " " &amp; First(Fields!AttentionFirstName.Value, "ShippingToCustomerHeader") &amp; " " &amp; First(Fields!AttentionLastName.Value, "ShippingToCustomerHeader")) &amp; vbCrLf &amp; First(Fields!RecipientCompanyName.Value, "ShippingToCustomerHeader") &amp; vbCrLf &amp; First(Fields!RecipientAddressLine1.Value, "ShippingToCustomerHeader") &amp; vbCrLf &amp; First(Fields!RecipientAddressLine2.Value, "ShippingToCustomerHeader") &amp; vbCrLf &amp; First(Fields!RecipientAddressLine3.Value, "ShippingToCustomerHeader") &amp; vbCrLf &amp; First(Fields!RecipientCity.Value, "ShippingToCustomerHeader") &amp; IIf(First(Fields!RecipientState.Value, "ShippingToCustomerHeader") &lt;&gt; "", ", " &amp; First(Fields!RecipientState.Value, "ShippingToCustomerHeader"), "") &amp; IIf(First(Fields!RecipientRegion.Value, "ShippingToCustomerHeader") &lt;&gt; "", " / " &amp; First(Fields!RecipientRegion.Value, "ShippingToCustomerHeader"), "") &amp; vbCrLf &amp; First(Fields!RecipientPostCode.Value, "ShippingToCustomerHeader") &amp; vbCrLf &amp; First(Fields!RecipientCountry.Value, "ShippingToCustomerHeader")</Value>
                <Style>
                  <FontSize>8pt</FontSize>
                </Style>
              </TextRun>
            </TextRuns>
            <Style />
          </Paragraph>
        </Paragraphs>
        <Top>0.325in</Top>
        <Left>0.55in</Left>
        <Height>1.2in</Height>
        <Width>3.65in</Width>
        <ZIndex>1</ZIndex>
        <Style>
          <FontFamily>Segoe UI</FontFamily>
        </Style>
      </Textbox>
      <Textbox Name="CustomerContactBlock">
        <CanGrow>true</CanGrow>
        <KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>="Land Line: " &amp; First(Fields!BusinessPhone.Value, "ShippingToCustomerHeader") &amp; vbCrLf &amp; "Mobile: " &amp; First(Fields!MobileNumber.Value, "ShippingToCustomerHeader") &amp; vbCrLf &amp; "Email: " &amp; First(Fields!EmailAddress.Value, "ShippingToCustomerHeader")</Value>
                <Style>
                  <FontSize>8pt</FontSize>
                </Style>
              </TextRun>
            </TextRuns>
            <Style />
          </Paragraph>
        </Paragraphs>
        <Top>1.625in</Top>
        <Left>0.55in</Left>
        <Height>0.55in</Height>
        <Width>3.65in</Width>
        <ZIndex>2</ZIndex>
        <Style>
          <FontFamily>Segoe UI</FontFamily>
        </Style>
      </Textbox>
      <Textbox Name="CommercialBlock">
        <CanGrow>true</CanGrow>
        <KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>="Incoterms: " &amp; First(Fields!Incoterms.Value, "ShippingToCustomerHeader") &amp; vbCrLf &amp; vbCrLf &amp; "EORI Number: " &amp; First(Fields!EoriNumber.Value, "ShippingToCustomerHeader") &amp; vbCrLf &amp; vbCrLf &amp; "Currency: " &amp; First(Fields!Currency.Value, "ShippingToCustomerHeader")</Value>

<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2008/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <Body>
    <ReportItems>
      <Textbox Name="Title">
        <CanGrow>true</CanGrow>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>=First(Fields!ReportTitle.Value, "EngineerMonthlySummary")</Value>
                <Style>
                  <FontFamily>Segoe UI</FontFamily>
                  <FontSize>16pt</FontSize>
                  <FontWeight>Bold</FontWeight>
                </Style>
              </TextRun>
            </TextRuns>
            <Style />
          </Paragraph>
        </Paragraphs>
        <Top>0.08in</Top>
        <Left>0.25in</Left>
        <Height>0.3in</Height>
        <Width>7.3in</Width>
        <Style />
      </Textbox>
      <Textbox Name="Range">
        <CanGrow>true</CanGrow>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>=First(Fields!DateRangeText.Value, "EngineerMonthlySummary")</Value>
                <Style>
                  <FontFamily>Segoe UI</FontFamily>
                  <FontSize>9pt</FontSize>
                </Style>
              </TextRun>
            </TextRuns>
            <Style />
          </Paragraph>
        </Paragraphs>
        <Top>0.42in</Top>
        <Left>0.25in</Left>
        <Height>0.2in</Height>
        <Width>7.3in</Width>
        <ZIndex>1</ZIndex>
        <Style />
      </Textbox>
      <Textbox Name="Overview">
        <CanGrow>true</CanGrow>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>="Total jobs: " &amp; First(Fields!TotalJobs.Value, "EngineerMonthlySummary") &amp; " | Confirmed: " &amp; First(Fields!ConfirmedJobs.Value, "EngineerMonthlySummary") &amp; " | Unconfirmed: " &amp; First(Fields!UnconfirmedJobs.Value, "EngineerMonthlySummary") &amp; " | Days on site: " &amp; Format(First(Fields!DaysOnSite.Value, "EngineerMonthlySummary"), "0.0")</Value>
                <Style>
                  <FontFamily>Segoe UI</FontFamily>
                  <FontSize>8.5pt</FontSize>
                </Style>
              </TextRun>
            </TextRuns>
            <Style />
          </Paragraph>
        </Paragraphs>
        <Top>0.7in</Top>
        <Left>0.25in</Left>
        <Height>0.24in</Height>
        <Width>7.3in</Width>
        <ZIndex>2</ZIndex>
        <Style>
          <Border>
            <Color>#e5eaf3</Color>
            <Style>Solid</Style>
          </Border>
          <BackgroundColor>#f8f9fc</BackgroundColor>
          <PaddingLeft>4pt</PaddingLeft>
          <PaddingTop>2pt</PaddingTop>
          <PaddingBottom>2pt</PaddingBottom>
        </Style>
      </Textbox>
    </ReportItems>
    <Height>1.1in</Height>
    <Style />
  </Body>
  <Width>7.7in</Width>
  <Page>
    <PageHeader>
      <Height>0.9in</Height>
      <PrintOnFirstPage>true</PrintOnFirstPage>
      <PrintOnLastPage>true</PrintOnLastPage>
      <ReportItems>
        <Image Name="CompanyLogoImage">
          <Source>Database</Source>
          <Value>=First(Fields!LogoBytes.Value, "CompanyHeader")</Value>
          <MIMEType>image/png</MIMEType>
          <Sizing>FitProportional</Sizing>
          <Top>0.05in</Top>
          <Left>0.25in</Left>
          <Height>0.75in</Height>
          <Width>2.2in</Width>
          <Style />
        </Image>
      </ReportItems>
      <Style />
    </PageHeader>
    <PageFooter>
      <Height>0.45in</Height>
      <PrintOnFirstPage>true</PrintOnFirstPage>
      <PrintOnLastPage>true</PrintOnLastPage>
      <ReportItems>
        <Textbox Name="PrintDateTime">
          <CanGrow>true</CanGrow>
          <Paragraphs>
            <Paragraph>
              <TextRuns>
                <TextRun>
                  <Value>="Date printed: " &amp; Today() &amp; "    Time printed: " &amp; TimeOfDay</Value>
                  <Style>
                    <FontFamily>Segoe UI</FontFamily>
                    <FontSize>8pt</FontSize>
                  </Style>
                </TextRun>
              </TextRuns>
              <Style />
            </Paragraph>
          </Paragraphs>
          <Top>0.04in</Top>
          <Left>0.25in</Left>
          <Height>0.18in</Height>
          <Width>4.6in</Width>
          <Style />
        </Textbox>
        <Textbox Name="PageNumberText">
          <CanGrow>true</CanGrow>
          <Paragraphs>
            <Paragraph>
              <TextRuns>
                <TextRun>
                  <Value>="Page " &amp; Globals!PageNumber &amp; " of " &amp; Globals!TotalPages</Value>
                  <Style>
                    <FontFamily>Segoe UI</FontFamily>
                    <FontSize>8pt</FontSize>
                  </Style>
                </TextRun>
              </TextRuns>
              <Style>
                <TextAlign>Right</TextAlign>
              </Style>
            </Paragraph>
          </Paragraphs>
          <Top>0.04in</Top>
          <Left>5.2in</Left>
          <Height>0.18in</Height>
          <Width>2.3in</Width>
          <ZIndex>1</ZIndex>
          <Style />
        </Textbox>
      </ReportItems>
      <Style />
    </PageFooter>
    <PageHeight>11.69in</PageHeight>
    <PageWidth>8.27in</PageWidth>
    <LeftMargin>0.3in</LeftMargin>
    <RightMargin>0.3in</RightMargin>
    <TopMargin>0.3in</TopMargin>
    <BottomMargin>0.3in</BottomMargin>
    <Style />
  </Page>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="OnSiteEngineerDataSource">
      <ConnectionProperties>
        <DataProvider>System.Data.DataSet</DataProvider>
        <ConnectString />
      </ConnectionProperties>
      <rd:DataSourceID>ec623e11-08af-4b41-8bd4-c8d614dc0b36</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="CompanyHeader">
      <Query>
        <DataSourceName>OnSiteEngineerDataSource</DataSourceName>
        <CommandText />
      </Query>
      <Fields>
        <Field Name="CompanyName">
          <DataField>CompanyName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="LogoBytes">
          <DataField>LogoBytes</DataField>
          <rd:TypeName>System.Byte[]</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="EngineerMonthlySummary">
      <Query>
        <DataSourceName>OnSiteEngineerDataSource</DataSourceName>
        <CommandText />
      </Query>
      <Fields>
        <Field Name="ReportTitle">
          <DataField>ReportTitle</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DateRangeText">
          <DataField>DateRangeText</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="TotalJobs">
          <DataField>TotalJobs</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="ConfirmedJobs">
          <DataField>ConfirmedJobs</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="UnconfirmedJobs">
          <DataField>UnconfirmedJobs</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="DaysOnSite">
          <DataField>DaysOnSite</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
  <rd:ReportUnitType>Inch</rd:ReportUnitType>
  <rd:ReportID>6b6d0f1c-c0db-4fb1-8ae6-80596631b2c5</rd:ReportID>
</Report>
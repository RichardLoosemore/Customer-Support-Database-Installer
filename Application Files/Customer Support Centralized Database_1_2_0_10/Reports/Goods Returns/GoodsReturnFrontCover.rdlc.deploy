<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2008/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <Body>
    <ReportItems>
      <Textbox Name="TitleTextbox">
        <CanGrow>true</CanGrow>
        <KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>Goods Returns Number: </Value>
                <Style>
                  <FontSize>14pt</FontSize>
                  <FontWeight>Bold</FontWeight>
                </Style>
              </TextRun>
              <TextRun>
                <Value>=First(Fields!GRNumber.Value, "GoodsReturnHeader")</Value>
                <Style>
                  <FontSize>14pt</FontSize>
                  <FontWeight>Bold</FontWeight>
                </Style>
              </TextRun>
            </TextRuns>
            <Style />
          </Paragraph>
        </Paragraphs>
        <Top>0.4in</Top>
        <Left>2.5in</Left>
        <Height>0.4in</Height>
        <Width>4in</Width>
        <Style>
          <FontFamily>Segoe UI</FontFamily>
        </Style>
      </Textbox>
      <Textbox Name="AddressTextbox">
        <CanGrow>true</CanGrow>
        <KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>="Customer: " &amp; First(Fields!CustomerName.Value, "GoodsReturnHeader") &amp; vbCrLf &amp; "Factory: " &amp; First(Fields!FactoryName.Value, "GoodsReturnHeader") &amp; IIf(First(Fields!CustomerEmail.Value, "GoodsReturnHeader") &lt;&gt; "", vbCrLf &amp; "Email: " &amp; First(Fields!CustomerEmail.Value, "GoodsReturnHeader"), "")</Value>
                <Style>
                  <FontSize>9pt</FontSize>
                </Style>
              </TextRun>
            </TextRuns>
            <Style />
          </Paragraph>
        </Paragraphs>
        <Top>1.2in</Top>

  <Body>
    <ReportItems>
      <Textbox Name="NoticeTextbox">
        <CanGrow>true</CanGrow>
        <KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>PLEASE PLACE A COPY OF THIS FORM INSIDE THE SHIPMENT</Value>
                <Style>
                  <FontSize>9pt</FontSize>
                  <FontWeight>Bold</FontWeight>
                  <Color>Silver</Color>
                </Style>
              </TextRun>
            </TextRuns>
            <Style>
              <TextAlign>Center</TextAlign>
            </Style>
          </Paragraph>
        </Paragraphs>
        <Top>0.125in</Top>
        <Left>0.25in</Left>
        <Height>0.25in</Height>
        <Width>6.75in</Width>
        <Style>
          <BackgroundColor>=First(Fields!PrimaryColour.Value, "GoodsReturnHeader")</BackgroundColor>
